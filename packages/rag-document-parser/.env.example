# RAG Document Parser 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# ==================== 服务配置 ====================
# 服务端口
PORT=8000
# 绑定主机
HOST=0.0.0.0
# 工作进程数（生产环境建议设置为CPU核心数）
WORKERS=1
# 热重载（开发模式启用）
RELOAD=true

# ==================== 文件处理配置 ====================
# 最大上传大小（字节）
MAX_UPLOAD_SIZE=104857600  # 100MB
# 临时文件目录
TEMP_DIR=./temp
# 是否保留临时文件
KEEP_TEMP_FILES=false

# ==================== 解析配置 ====================
# 默认PDF引擎：pymupdf 或 pdfplumber
PDF_ENGINE=pymupdf
# 启用OCR
ENABLE_OCR=true
# OCR触发阈值（字符数少于该值时触发OCR）
OCR_THRESHOLD=50
# 启用Office转换
ENABLE_OFFICE_CONVERSION=true
# LibreOffice路径（空为自动检测）
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Tesseract路径（空为自动检测）
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ==================== 性能配置 ====================
# 最大并发任务数
MAX_CONCURRENT_TASKS=5
# 任务超时时间（秒）
TASK_TIMEOUT=300
# OCR超时时间（秒）
OCR_TIMEOUT=60
# 转换超时时间（秒）
CONVERSION_TIMEOUT=120

# ==================== 日志配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志格式：json 或 text
LOG_FORMAT=json
# 日志文件（空为控制台输出）
# LOG_FILE=./logs/app.log

# ==================== 监控配置 ====================
# 启用Prometheus指标
ENABLE_METRICS=true
# 指标端点路径
METRICS_PATH=/metrics
# 启用健康检查
ENABLE_HEALTH_CHECKS=true

# ==================== 高级配置 ====================
# 内存使用限制（MB，0为无限制）
MEMORY_LIMIT_MB=0
# CPU使用限制（0.0-1.0，0为无限制）
CPU_LIMIT=0
# 启用请求限流
ENABLE_RATE_LIMIT=false
# 每秒请求数限制
RATE_LIMIT_PER_SECOND=10

# ==================== 开发配置 ====================
# 启用详细调试信息
DEBUG=false
# 启用SQL查询日志
LOG_SQL=false
# 测试模式
TESTING=false